# Database Mode: SQLite (Local) or PostgreSQL (Neon Cloud)
# ----------------------------------------------------
# 1. Local SQLite (Default - zero setup needed):
DATABASE_URL=sqlite+aiosqlite:///./local_tasks.db

# 2. Cloud Neon PostgreSQL (Uncomment and replace with your Neon connection string):
# DATABASE_URL=postgresql+asyncpg://neondb_owner:your_password@ep-cool-snowflake-123456.us-east-2.aws.neon.tech/neondb?ssl=require

# Application Settings
APP_NAME=Task Flow API
DEBUG=True
API_V1_PREFIX=/api/v1
CORS_ORIGINS=["*"]

# Background Alert Checker Interval in seconds (e.g. 60 seconds)
ALERT_CHECK_INTERVAL_SECONDS=60
